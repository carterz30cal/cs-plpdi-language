#import "examples/list.otwo"
#import "examples/dict.otwo"
#import "examples/number.otwo"

num function fibonacci 0 = 0;
num function fibonacci 1 = 1;
num function fibonacci n = fibonacci (n - 2) + fibonacci (n - 1);
let num testing = 5;
emit "result" fibonacci(testing);

num function fibontwo n = {
    let num r;
    if (n == 0) {r = 0;}
    else {
        if (n == 1) {r = 1;}
        else {
            r = fibontwo(n - 2) + fibontwo(n - 1);
        }
    }
    return r;
}

emit "result2" fibontwo(testing);

list[any] function sample = Cons[1, Cons[2, Empty[]]];
list[num] function ones = Cons[1, ones()];

emit "listtest" empty(tail(tail(sample())));

emit "pushtest" prepend(sample(), 3);

emit "emptytest" Empty[];


let any pfunc = head();
emit "partialtest" pfunc;
emit "applytest" pfunc(sample());


num function increment x = x + 1;
num function add x y = x + y;

emit "mapping" head(map(increment(), sample()));
emit "label" (1 + 1);
emit "combine" reduce(add(), sample());

