list[any] function append x Empty[] = Cons[x, Empty[]];
list[any] function append x Cons[y,ys] = Cons[y,append(x,ys)]; 

any function at Cons[x,_] 0 = x;
any function at Cons[_,xs] n = at(xs, n - 1); 

num function increment x = x + 1;
num function add x y = x + y;

list[any] function map f xs = {
    let any ys = Empty[];
    if (xs != Empty) {
        for (let num i = 0, i < length(xs), i = i + 1) {
            ys = append(f(at(xs,i)), ys);
        }
    }
    return ys;
}
// f - function must take two arguments x y
any function combine f Cons[x,Cons[y,Empty[]]] = f(x,y);
any function combine f Cons[x,xs] = {
    return f(x, combine(f, xs));
}

emit "mapping" head(map(increment(), sample()));
