/*
LIST DEFINITION
AUTHOR: carterz30cal
VERSION: 1
SINCE: 1.0.0
documentation placeholder
*/

type list any = Empty or Cons(any, list[any]);

// head/tail functions
any function head Cons[x,_] = x;
list[any] function tail Cons[_,xs] = xs;

// property functions
bool function empty Empty[] = true;
bool function empty _ = false;
num function length Empty[] = 0;
num function length Cons[_,xs] = 1 + length(xs);
any function at Empty[] _ = null; // if ever evaluated, will error.
any function at Cons[x,_] 0 = x;
any function at Cons[_,xs] n = at(xs, n - 1);

// modifier functions
list[any] function append x Empty[] = Cons[x, Empty[]];
list[any] function append x Cons[y,ys] = Cons[y, append(x,ys)];
list[any] function prepend x Empty[] = Cons[x, Empty[]];
list[any] function prepend x ys = Cons[x, ys];

list[any] function map f xs = {
    let list[any] zs = Empty[];
    if (xs != Empty[]) {
        for (let num i = 0, i < length(xs), i += 1) {
            zs = append(f(at(xs,i)), zs);
            emit "xs" xs;
            emit "at" at(xs);
            emit "f" f;
            emit "ys" head(zs);
        }
    } 
    return zs;
}

/*
the parameter f must be a partial function that can take two arguments
of type any (or at least accept the type being passed). the function will
not be called on a list with a single element.
*/
any function reduce f Empty[] = null;
any function reduce f Cons[x, Empty[]] = x;
any function reduce f Cons[x, xs] = {
    return f(x, reduce(f, xs));
}
