/*
The worst possible implementation of a dictionary, with O(n) lookup time (yikes!)
*/

#import "maybe.otwo"
type dict k v = EmptyDict or Dict(k, v, dict[k,v]);

maybe[any] function find k EmptyDict[] = Nothing[];
maybe[any] function find k Dict[key, val, ds] = {
    let any result;
    if (k == key) {
        result = Just[val];
    }
    else {
        result = find(k, ds);
    }
    return result;
}